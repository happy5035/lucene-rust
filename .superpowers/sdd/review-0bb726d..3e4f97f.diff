+fn expect_intersect(a: &[u32], b: &[u32]) -> Vec<u32> {
+    a.iter().filter(|x| b.contains(x)).copied().collect()
+}
+
+fn expect_andnot(a: &[u32], b: &[u32]) -> Vec<u32> {
+    a.iter().filter(|x| !b.contains(x)).copied().collect()
+}
